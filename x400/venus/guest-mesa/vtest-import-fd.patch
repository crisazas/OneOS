+/* linux-x400: VCMD_RESOURCE_IMPORT_FD. Hands the server a dma-buf made outside Venus (a GBM buffer: KWin's, Zink's) and gets back
+ * a resource id the renderer side can import as VkDeviceMemory. The fd rides on one extra byte as SCM_RIGHTS. */
+static uint32_t
+vtest_vcmd_resource_import_fd(struct vtest *vtest, int fd, VkDeviceSize size)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t vcmd[VCMD_RES_IMPORT_FD_SIZE];
+
+   vtest_hdr[VTEST_CMD_LEN] = VCMD_RES_IMPORT_FD_SIZE;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_RESOURCE_IMPORT_FD;
+   vcmd[VCMD_RES_IMPORT_FD_TYPE] = 0;
+   vcmd[VCMD_RES_IMPORT_FD_SIZE_LO] = (uint32_t)size;
+   vcmd[VCMD_RES_IMPORT_FD_SIZE_HI] = (uint32_t)(size >> 32);
+
+   vtest_write(vtest, vtest_hdr, sizeof(vtest_hdr));
+   vtest_write(vtest, vcmd, sizeof(vcmd));
+
+   char cmsg_buf[CMSG_SPACE(sizeof(int))];
+   char dummy = 0;
+   memset(cmsg_buf, 0, sizeof(cmsg_buf));
+   struct msghdr msg = {
+      .msg_iov = &(struct iovec){ .iov_base = &dummy, .iov_len = sizeof(dummy) },
+      .msg_iovlen = 1,
+      .msg_control = cmsg_buf,
+      .msg_controllen = sizeof(cmsg_buf),
+   };
+   struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+   cmsg->cmsg_level = SOL_SOCKET;
+   cmsg->cmsg_type = SCM_RIGHTS;
+   cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+   *((int *)CMSG_DATA(cmsg)) = fd;
+   if (sendmsg(vtest->sock_fd, &msg, 0) < 0) {
+      vn_log(vtest->instance, "sendmsg failed: %s", strerror(errno));
+      abort();
+   }
+
+   vtest_read(vtest, vtest_hdr, sizeof(vtest_hdr));
+   assert(vtest_hdr[VTEST_CMD_LEN] == 1);
+   assert(vtest_hdr[VTEST_CMD_ID] == VCMD_RESOURCE_IMPORT_FD);
+
+   uint32_t res_id;
+   vtest_read(vtest, &res_id, sizeof(res_id));
+   return res_id;
+}
