+/*
+ * Fallback allocator for drivers that cannot export memory and have no gbm: host
+ * visible memory is carved from a dma-heap and imported as dma-buf. The heap node
+ * defaults to /dev/dma_heap/system and can be overridden with the environment
+ * variable VKR_DMA_HEAP_NODE (full path of the heap device).
+ */
+#include <fcntl.h>
+
+#define VKR_DMA_HEAP_DEFAULT_NODE "/dev/dma_heap/system"
+
+static int
+vkr_physical_device_open_dma_heap(void)
+{
+   const char *node = getenv("VKR_DMA_HEAP_NODE");
+   if (!node || !node[0])
+      node = VKR_DMA_HEAP_DEFAULT_NODE;
+
+   const int fd = open(node, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      vkr_log("failed to open dma-heap %s: %s", node, strerror(errno));
+   else
+      vkr_log("dma-heap %s opened for host visible memory", node);
+   return fd;
+}
+
